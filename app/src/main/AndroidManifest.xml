<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Saving "add to calendar" results straight into the phone's calendar. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- Showing what an auto action made of an incoming message (a translation, say). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <queries>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
        <!-- Listing apps to pick from when a held key should act only in one app. -->
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
        <!-- Seeing whether LinkedIn (or another app) can take a drafted post straight from the share sheet. -->
        <intent><action android:name="android.intent.action.SEND" /><data android:mimeType="text/plain" /></intent>
    </queries>
    <application android:label="Verbo" android:icon="@mipmap/ic_launcher" android:theme="@style/AppTheme" android:allowBackup="false">
        <activity android:name=".MainActivity" android:exported="true" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".PageActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <!-- WhatsApp & co. hand Verbo a message or file here; it waits in the keyboard's inbox. -->
        <activity android:name=".ShareActivity" android:exported="true" android:launchMode="singleTop" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/*" />
                <data android:mimeType="text/*" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <!-- "Continue with Google": the dashboard hands the browser back here with a one-time code. -->
        <activity android:name=".AuthActivity" android:exported="true" android:excludeFromRecents="true" android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="verbo" android:host="auth" />
            </intent-filter>
        </activity>
        <!-- Invisible: the keyboard can't show permission prompts itself, so it opens this to ask and then save. -->
        <activity android:name=".CalendarPermissionActivity" android:exported="false" android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Off until the user turns on "Act on incoming messages" and grants notification access. -->
        <service android:name=".MessageListener" android:label="Verbo: act on incoming messages" android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
        </service>
        <!-- directBootAware lets the keyboard work on the lock screen right after a reboot. -->
        <service android:name=".VerboIme" android:label="Verbo Keyboard" android:directBootAware="true"
            android:permission="android.permission.BIND_INPUT_METHOD" android:exported="true">
            <intent-filter><action android:name="android.view.InputMethod" /></intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method" />
        </service>
    </application>
</manifest>
