# The domain name that points at this server, e.g. verbo.example.com
DOMAIN=
# Encrypts saved tokens and API keys. Generate once with: openssl rand -hex 32
# Keep it safe: if it changes, saved tokens can no longer be read.
SECRET_KEY=
# Set to false after creating your accounts to stop strangers signing up.
ALLOW_SIGNUP=true

# Optional: lets paired keyboards create Google Meet links. See "Google Meet" in README.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
