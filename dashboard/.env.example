# The domain name that points at this server, e.g. verbo.example.com
DOMAIN=
# Encrypts saved tokens and API keys. Generate once with: openssl rand -hex 32
# Keep it safe: if it changes, saved tokens can no longer be read.
SECRET_KEY=
# Set to false after creating your accounts to stop strangers signing up.
ALLOW_SIGNUP=true

# Optional: lets paired keyboards create Google Meet links. See "Google Meet" in README.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The public address, e.g. https://verbo.example.com. Needed for Google (sign-in, Meet, Calendar, Gmail).
# docker-compose sets it from DOMAIN; set it yourself on other hosts (Nimbuz, Render...).
PUBLIC_URL=

# Verbo Pro. Keys from dashboard.razorpay.com → Account & Settings → API keys (use Test mode keys first).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay → Webhooks → Add: URL https://your-domain/api/billing/webhook, event payment_link.paid, and this secret.
RAZORPAY_WEBHOOK_SECRET=
# Prices in paise: 49900 = ₹499.
PRO_LIFETIME_PAISE=49900
PRO_MONTH_PAISE=9900
# Phones one account may have paired at once.
DEVICE_LIMIT=3
# Emails that always have Pro (you, testers), comma-separated.
ADMIN_EMAILS=
